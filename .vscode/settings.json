{
  "js/ts.tsdk.path": "node_modules/typescript/lib",
  "files.associations": {
    "*.css": "tailwindcss"
  },
  "oxc.fmt.configPath": ".oxfmtrc.json",
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "editor.formatOnSave": false,

  // ─── Formatting ─────────────────────────────────────────────────────────────
  // Format on save by running the oxfmt CLI via the "Run on Save" extension
  // (emeraldwalk.runonsave) — NOT the oxc extension's built-in oxfmt formatter.
  // That formatter is unreliable upstream: it frequently fails to register / does
  // nothing (oxc-project/oxc #17586, #18410) and the LSP doesn't apply .oxfmtrc.json
  // (#21385), silently falling back to VS Code's built-in TS formatter (wrong rules).
  // The oxfmt CLI is rock-solid and reads .oxfmtrc.json.
  // Requires: (1) trust this workspace, (2) install emeraldwalk.runonsave.
  // See Also: https://github.com/novemberfiveco/oxc-config/pull/5
  "emeraldwalk.runonsave": {
    "commands": [
      {
        "match": "\\.(ts|tsx|js|jsx|mjs|cjs|json|css|scss|md|ya?ml|html)$",
        "cmd": "\"${workspaceFolder}/node_modules/.bin/oxfmt\" \"${file}\""
      }
    ]
  },

  // ─── Linting (oxlint via the oxc extension) ──────────────────────────────────
  "oxc.enable": true,
  "oxc.enable.oxlint": true
}
