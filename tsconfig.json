{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ESNext", "DOM"],
    "types": ["node", "vite/client"],
    "jsx": "preserve",
    "jsxImportSource": "vue",
    "strict": true,
    "useDefineForClassFields": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "paths": {
      "@noob-naive-ui/admin": ["./packages/admin/src/index.ts"],
      "@noob-naive-ui/admin-vue-router": [
        "./packages/admin-vue-router/src/index.ts"
      ],
      "@noob-naive-ui/i18n": ["./packages/i18n/src/index.ts"],
      "@noob-naive-ui/ui": ["./packages/ui/src/index.ts"]
    }
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/src/**/*.tsx",
    "packages/*/tests/**/*.ts",
    "packages/*/tests/**/*.tsx",
    "apps/demo/src/**/*.ts",
    "apps/demo/src/**/*.tsx",
    "tooling/**/*.ts"
  ],
  "exclude": ["node_modules", "dist", "**/dist"]
}
