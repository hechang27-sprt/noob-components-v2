{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ESNext", "DOM"],
    "types": ["node", "vite/client"],
    "jsx": "preserve",
    "jsxImportSource": "vue",
    "strict": true,
    "useDefineForClassFields": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "paths": {
      "@noob-naive-ui/admin": ["./packages/admin/src/index.ts"],
      "@noob-naive-ui/admin-vue-router": [
        "./packages/admin-vue-router/src/index.ts"
      ],
      "@noob-naive-ui/i18n": ["./packages/i18n/src/index.ts"],
      "@noob-naive-ui/prototype-i18n-verification": [
        "./packages/prototype-i18n-verification/src/index.ts"
      ],
      "@noob-naive-ui/registry": ["./packages/registry/src/index.ts"],
      "@noob-naive-ui/ui": ["./packages/ui/src/index.ts"],
      "@noob/admin": ["./packages/admin/src/index.ts"],
      "@noob/admin-vue-router": ["./packages/admin-vue-router/src/index.ts"],
      "@noob/i18n": ["./packages/i18n/src/index.ts"],
      "@noob/prototype-i18n-verification": [
        "./packages/prototype-i18n-verification/src/index.ts"
      ],
      "@noob/registry": ["./packages/registry/src/index.ts"],
      "@noob/ui": ["./packages/ui/src/index.ts"],
      "~/ui/*": ["./packages/ui/src/*"],
      "~/registry/*": ["./packages/registry/src/*"],
      "~/i18n/*": ["./packages/i18n/src/*"],
      "~/admin/*": ["./packages/admin/src/*"],
      "~/admin-vue-router/*": ["./packages/admin-vue-router/src/*"],
      "~/prototype-i18n-verification/*": [
        "./packages/prototype-i18n-verification/src/*"
      ]
    }
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/src/**/*.tsx",
    "packages/*/tests/**/*.ts",
    "packages/*/tests/**/*.tsx",
    "apps/demo/src/**/*.ts",
    "apps/demo/src/**/*.tsx",
    "tooling/**/*.ts"
  ],
  "exclude": ["node_modules", "dist", "**/dist"]
}
