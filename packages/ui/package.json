{
  "name": "@noob-naive-ui/ui",
  "version": "0.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "vite build",
    "clean": "node -e \"const fs=require('node:fs');fs.rmSync('dist',{recursive:true,force:true});fs.rmSync('tsconfig.tsbuildinfo',{force:true})\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@noob-naive-ui/i18n": "workspace:*",
    "es-toolkit": "^1.42.0",
    "@noob-naive-ui/registry": "workspace:*",
    "tailwind-variants": "^3.3.1"
  },
  "peerDependencies": {
    "naive-ui": "catalog:",
    "vue": "catalog:",
    "vue-i18n": "catalog:"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "description": "Theme-var-driven UI primitives (UiCardTabs, proof components) for @noob-naive-ui.",
  "devDependencies": {
    "@noob/tooling-vite": "workspace:*",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}
