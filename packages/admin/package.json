{
  "name": "@noob-naive-ui/admin",
  "version": "0.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "pnpm run clean && vite build",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "naive-ui": "catalog:",
    "pinia": "catalog:",
    "pro-naive-ui": "catalog:",
    "vue": "catalog:",
    "vue-i18n": "catalog:"
  },
  "dependencies": {
    "@noob-naive-ui/i18n": "workspace:*",
    "@noob-naive-ui/ui": "workspace:*",
    "@vicons/ionicons5": "^0.13.0",
    "es-toolkit": "^1.42.0",
    "zod": "catalog:",
    "@noob-naive-ui/registry": "workspace:*"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "description": "Admin application shell, providers, theme presets, and preference stores for @noob-naive-ui.",
  "devDependencies": {
    "@noob/tooling-vite": "workspace:*"
  }
}
