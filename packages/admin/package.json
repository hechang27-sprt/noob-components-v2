{
  "name": "@noob-naive-ui/admin",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "vite build",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "naive-ui": "^2.43.1",
    "pinia": "^3.0.4",
    "pro-naive-ui": "^3.2.3",
    "vue": "^3.5.0"
  },
  "dependencies": {
    "@noob-naive-ui/ui": "workspace:*",
    "@vicons/ionicons5": "^0.13.0",
    "zod": "^4.4.3"
  }
}
