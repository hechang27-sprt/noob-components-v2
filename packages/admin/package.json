{
  "name": "@noob-naive-ui/admin",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm run clean && vite build && pnpm run build:types",
    "build:types": "tsc -p tsconfig.json --emitDeclarationOnly",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "naive-ui": "^2.43.1",
    "pinia": "^3.0.4",
    "pro-naive-ui": "^3.2.3",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "happy-dom": "^20.10.6",
    "pinia": "^3.0.4",
    "pro-naive-ui": "^3.2.3",
    "tailwindcss": "^4.3.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "zod": "^4.4.3"
  }
}
