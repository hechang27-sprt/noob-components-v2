{
  "name": "@noob-naive-ui/i18n",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "clean": "node -e \"const fs=require('node:fs');fs.rmSync('dist',{recursive:true,force:true});fs.rmSync('tsconfig.tsbuildinfo',{force:true})\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "vue": "catalog:",
    "vue-i18n": "catalog:",
    "zod": "catalog:",
    "@noob-naive-ui/registry": "workspace:*"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "description": "Component-first i18n: createComponentI18n local composers, override selection, and text resolution.",
  "devDependencies": {
    "@noob/tooling-vite": "workspace:*",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}
