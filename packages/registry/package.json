{
  "name": "@noob-naive-ui/registry",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "clean": "node -e \"const fs=require('node:fs');fs.rmSync('dist',{recursive:true,force:true});fs.rmSync('tsconfig.tsbuildinfo',{force:true})\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "naive-ui": "catalog:",
    "vue": "catalog:"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "description": "Shared override registry, theme/font-size helpers, and module-augmentation types for @noob-naive-ui packages.",
  "devDependencies": {
    "@noob/tooling-vite": "workspace:*",
    "typescript": "catalog:"
  }
}
