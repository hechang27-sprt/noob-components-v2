{
  "name": "@noob-naive-ui/prototype-i18n-verification",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vite": {
      "types": "./vite.d.ts",
      "import": "./vite.mjs"
    }
  },
  "files": [
    "dist",
    "vite.mjs",
    "vite.d.ts"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "vite build",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "tsafe": "^1.8.12"
  },
  "peerDependencies": {
    "vue": "catalog:",
    "vue-i18n": "catalog:"
  }
}
