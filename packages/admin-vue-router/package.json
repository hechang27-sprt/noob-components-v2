    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@noob-naive-ui/admin": "workspace:*",
    "pinia": "^3.0.4",
    "vue": "^3.5.0",
    "vue-router": "^4.5.1",
    "zod": "^4.4.3"
  }
}
