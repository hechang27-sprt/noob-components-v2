{
  "name": "@noob-naive-ui/admin-vue-router",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prebuild": "pnpm --filter @noob-naive-ui/admin build",
    "build": "pnpm run clean && vite build && pnpm run build:types",
    "build:types": "tsc -p tsconfig.json --emitDeclarationOnly",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "pretest": "pnpm --filter @noob-naive-ui/admin build",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretypecheck": "pnpm --filter @noob-naive-ui/admin build",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@noob-naive-ui/admin": "workspace:*",
    "vue": "^3.5.0",
    "vue-router": "^4.5.1"
  }
}
