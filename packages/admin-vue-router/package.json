{
  "name": "@noob-naive-ui/admin-vue-router",
  "version": "0.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "clean": "node -e \"const fs=require('node:fs');fs.rmSync('dist',{recursive:true,force:true});fs.rmSync('tsconfig.tsbuildinfo',{force:true})\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b tsconfig.json --force",
    "prebuild": "tsc -b tsconfig.json"
  },
  "peerDependencies": {
    "@noob-naive-ui/admin": "workspace:*",
    "@noob-naive-ui/i18n": "workspace:*",
    "pinia": "catalog:",
    "vue": "catalog:",
    "vue-router": "catalog:",
    "zod": "catalog:"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "description": "Type-safe admin router: route registry, payload codecs, and guards."
}
