{
  "name": "noob-components-v2",
  "private": true,
  "packageManager": "pnpm@11.12.0",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "tsc6 -p tsconfig.json --noEmit && pnpm --filter @noob/tooling-vite run typecheck",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "dev": "pnpm --filter admin-starter dev",
    "stat:ELOC": "find . -type f -not -path \"*/node_modules/*\" -not -path \"./.omp/*\" -not -path \"./.trellis/*\" -not -path \"./.git/*\" -not -path \"./.jj/*\" -not -path \"*/dist/*\" \\( -path \"*.ts\" -or -path \"*.tsx\" \\) -not -path \"*.test.*\" -exec wc -l {} +",
    "build:clean": "pnpm -r --if-present clean && pnpm -r build",
    "typecheck:all": "tsc6 -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@intlify/unplugin-vue-i18n": "^11.2.4",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.2",
    "@types/node": "^26.1.0",
    "@typescript/typescript6": "^6.0.2",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.10",
    "happy-dom": "^20.10.6",
    "naive-ui": "^2.44.1",
    "npm-run-all-next": "^1.4.2",
    "oxfmt": "^0.59.0",
    "oxlint": "^1.74.0",
    "oxlint-tsgolint": "^7.0.2001",
    "pinia": "^3.0.4",
    "pro-naive-ui": "^3.2.3",
    "rolldown": "^1.2.6",
    "rolldown-plugin-dts": "^0.28.4",
    "tailwindcss": "^4.3.2",
    "typescript": "catalog:",
    "vite": "^8.2.2",
    "vite-plugin-vue-devtools": "^8.1.5",
    "vitest": "^4.1.10",
    "vue": "^3.5.39",
    "vue-jsx-vapor": "^3.2.19",
    "vue-router": "^4.5.1",
    "zod": "^4.4.3"
  }
}
